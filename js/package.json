{
  "name": "thanos",
  "version": "0.1.0",
  "description": "Lightweight context-window limits, pricing-tier awareness, and compression for LLM conversations",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "thanos": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src/data/models.json"
  ],
  "keywords": [
    "llm",
    "context",
    "tokens",
    "pricing",
    "prompt-caching",
    "anthropic",
    "openai",
    "cli"
  ],
  "scripts": {
    "sync-pricing": "node scripts/sync-pricing.mjs",
    "build": "npm run sync-pricing && tsc -p tsconfig.json && chmod +x dist/cli.js",
    "test": "npm run sync-pricing && node --test --import tsx ./tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint": "npm run typecheck && npm run format:check"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "prettier": "^3.9.10",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/freakomonk/thanos"
  }
}
