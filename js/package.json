{
  "name": "thanos",
  "version": "0.1.0",
  "description": "Lightweight context-window limits, pricing-tier awareness, and compression for LLM conversations",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src/data/models.json"
  ],
  "keywords": ["llm", "context", "tokens", "pricing", "prompt-caching", "anthropic", "openai"],
  "scripts": {
    "sync-pricing": "node scripts/sync-pricing.mjs",
    "build": "npm run sync-pricing && tsc -p tsconfig.json",
    "test": "npm run sync-pricing && node --test --import tsx ./tests/*.test.ts"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "tsx": "^4.19.1",
    "@types/node": "^22.9.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/karthikeyasurabhi/thanos"
  }
}
